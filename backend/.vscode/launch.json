{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MCP Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "& \"${workspaceFolder}/.venv/Scripts/mcp\" dev backend.py",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        }
    ]
}